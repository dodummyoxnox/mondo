  "grammar": [
    {
      "id": "l23-g1",
      "lessonId": 23,
      "title": "V dictionary と",
      "pattern": "V dictionary と",
      "shortExplanation": "Pola ini adalah bagian penting dari tata bahasa pada pelajaran ini.",
      "detailedExplanation": "Materi Bab 23 ini berfokus pada pola “V dictionary と”. Gunakan pola ini dengan memperhatikan bentuk kata kerja, kata sifat, kata benda, dan partikel yang muncul sebelum atau sesudah pola. Untuk pemula, latihan terbaik adalah membuat kalimat pendek dulu, lalu mengganti kosakata sesuai konteks.",
      "structures": [
        {
