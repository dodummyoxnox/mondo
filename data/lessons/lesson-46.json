  "grammar": [
    {
      "id": "l46-g1",
      "lessonId": 46,
      "title": "V dictionary / Vている / Vた ところです",
      "pattern": "V dictionary / Vている / Vた ところです",
      "shortExplanation": "Pola ini adalah bagian penting dari tata bahasa pada pelajaran ini.",
      "detailedExplanation": "Materi Bab 46 ini berfokus pada pola “V dictionary / Vている / Vた ところです”. Gunakan pola ini dengan memperhatikan bentuk kata kerja, kata sifat, kata benda, dan partikel yang muncul sebelum atau sesudah pola. Untuk pemula, latihan terbaik adalah membuat kalimat pendek dulu, lalu mengganti kosakata sesuai konteks.",
      "structures": [
        {
          "id": "l46-g1-s1",
          "label": "Struktur dasar",
          "pattern": "V dictionary / Vている / Vた ところです",
          "meaning": "Pola ini adalah bagian penting dari tata bahasa pada pelajaran ini."
        }
      ],
      "examples": [
        {
          "id": "l46-g1-e1",
          "japanese": "いま かえってきたところです。",
          "romaji": "Ima kaette kita tokoro desu.",
          "indonesian": "Saya baru saja pulang."
        },
        {
          "id": "l46-g1-e2",
          "japanese": "じぶんの ことばで ぶんを つくってください。",
          "romaji": "Jibun no kotoba de bun o tsukutte kudasai.",
          "indonesian": "Buatlah kalimat dengan kata-katamu sendiri."
        }
      ],
      "commonMistakes": [
        {
          "id": "l46-m-90862",
