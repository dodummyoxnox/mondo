  "grammar": [
    {
      "id": "l48-g1",
      "lessonId": 48,
      "title": "Kata kerja kausatif",
      "pattern": "Kata kerja kausatif",
      "shortExplanation": "Dipakai untuk menyatakan menyuruh, membiarkan, atau membuat seseorang melakukan sesuatu.",
      "detailedExplanation": "Materi Bab 48 ini berfokus pada pola “Kata kerja kausatif”. Gunakan pola ini dengan memperhatikan bentuk kata kerja, kata sifat, kata benda, dan partikel yang muncul sebelum atau sesudah pola. Untuk pemula, latihan terbaik adalah membuat kalimat pendek dulu, lalu mengganti kosakata sesuai konteks.",
      "structures": [
        {
          "id": "l48-g1-s1",
