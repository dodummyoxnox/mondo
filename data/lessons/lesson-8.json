      "lessonId": 8,
      "title": "い-adj です",
      "pattern": "い-adj です",
      "shortExplanation": "Pola ini adalah bagian penting dari tata bahasa pada pelajaran ini.",
      "detailedExplanation": "Materi Bab 8 ini berfokus pada pola “い-adj です”. Gunakan pola ini dengan memperhatikan bentuk kata kerja, kata sifat, kata benda, dan partikel yang muncul sebelum atau sesudah pola. Untuk pemula, latihan terbaik adalah membuat kalimat pendek dulu, lalu mengganti kosakata sesuai konteks.",
      "structures": [
        {
          "id": "l8-g1-s1",
          "label": "Struktur dasar",
          "pattern": "い-adj です",
          "meaning": "Pola ini adalah bagian penting dari tata bahasa pada pelajaran ini."
        }
      ],
      "examples": [
        {
          "id": "l8-g1-e1",
          "japanese": "じてんしゃで がっこうへ いきます。",
          "romaji": "Jitensha de gakkou e ikimasu.",
          "indonesian": "Saya pergi ke sekolah naik sepeda."
        },
        {
          "id": "l8-g1-e2",
          "japanese": "じぶんの ことばで ぶんを つくってください。",
          "romaji": "Jibun no kotoba de bun o tsukutte kudasai.",
          "indonesian": "Buatlah kalimat dengan kata-katamu sendiri."
        }
      ],
      "commonMistakes": [
        {
          "id": "l8-m-13315",
          "wrong": "Mengikuti urutan kata bahasa Indonesia atau menghilangkan partikel.",
          "correct": "Gunakan struktur pola: い-adj です",
          "explanation": "Bahasa Jepang sangat bergantung pada bentuk kata dan partikel. Jangan hanya menerjemahkan kata demi kata dari bahasa Indonesia."
        }
      ],
      "practicePrompts": [
        "Buat 3 kalimat memakai pola い-adj です.",
        "Ubah satu kalimat Indonesia menjadi bahasa Jepang.",
        "Minta Harmoko Sensei mengoreksi kalimatmu."
      ]
    },
